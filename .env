# =============================================
# Bayani App (citizen) — Google Maps JavaScript API
# =============================================
# 1) Create a key at https://console.cloud.google.com/google/maps-apis
# 2) Enable the "Maps JavaScript API" (covers StreetViewService / StreetViewPanorama).
# 3) Restrict the key to HTTP referrers (e.g. http://localhost:4001/*).
# 4) Paste the key below (leave blank to keep the keyless iframe fallback).
#
VITE_GOOGLE_MAPS_API_KEY=

# =============================================
# Emergency SMS (backend) — used only when running `npm run server`
# from this project. The launcher runs the backend from bayani-alert,
# so the live SMS config lives in bayani-alert/.env.
# =============================================
# SMS_MODE=simulation
# SEMAPHORE_API_KEY=
# SEMAPHORE_SENDER_NAME=BAYANI
# SMS_PUBLIC_URL=http://localhost:4001

# =============================================
# Bayani Bridge — frontend base URL (Vite)
# =============================================
# Where the React apps talk to the backend that runs the Bridge (SSE + DB).
# Defaults to http://localhost:8000. Point this at your machine's LAN IP
# when the Response Center and the citizen app run on different devices.
#
VITE_BRIDGE_URL=http://localhost:8000
