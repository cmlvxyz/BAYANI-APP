# =============================================
# Bayani App (citizen) — Google Maps JavaScript API
# =============================================
# Required by the Live Location screen:
#   - Maps JavaScript API  -> StreetViewService / StreetViewPanorama
#   - Geocoding API        -> only if you swap the OSM reverse geocoder
#
# 1) Create a key at https://console.cloud.google.com/google/maps-apis
# 2) Enable "Maps JavaScript API" (covers StreetViewService / StreetViewPanorama).
# 3) Restrict the key to HTTP referrers (e.g. http://localhost:4001/*) and
#    restrict it to those APIs only.
# 4) Paste the key below. Leave blank and the Live Location screen still renders
#    a real Street View panorama through the keyless embed, but the nearest-
#    panorama search, compass heading and coverage detection stay disabled.
# NOTE: browsers only expose navigator.geolocation on https:// or localhost.
# On a LAN IP you must serve the app over https (or use a tunnel) for the device
# to grant location permission.
#
VITE_GOOGLE_MAPS_API_KEY=AIzaSyCGT4kID1SO0zXbWlunh1K0xenIx2drEvc

# =============================================
# Emergency SMS (backend) — used when running `npm run server`
# or start.bat from this project.
# =============================================
SMS_MODE=simulation
# SEMAPHORE_API_KEY=
# SEMAPHORE_SENDER_NAME=BAYANI
SMS_PUBLIC_URL=http://localhost:4001

# =============================================
# Bayani Bridge — frontend base URL (Vite)
# =============================================
# Leave VITE_BRIDGE_URL commented out: the frontend then defaults to the SAME
# host as the page (hostname:8000), so the app works from other PCs on the
# LAN without any config. Only set this if the backend runs on a different
# machine than the frontend.
#
# VITE_BRIDGE_URL=http://localhost:8000
#
# Same-origin bridge (via the Vite /bridge proxy) — needed so the app works
# through a single https tunnel from a phone on any network.
VITE_BRIDGE_URL=/bridge
