# =============================================
# Bayani App — Google Maps JavaScript API
# =============================================
# 1) Create a key at https://console.cloud.google.com/google/maps-apis
# 2) Enable the "Maps JavaScript API" (covers StreetViewService / StreetViewPanorama).
# 3) Restrict the key to HTTP referrers (e.g. http://localhost:4001/*).
# 4) Paste the key below (leave blank to keep the keyless iframe fallback).
#
VITE_GOOGLE_MAPS_API_KEY="AIzaSyCGT4kID1SO0zXbWlunh1K0xenIx2drEvc"

# =============================================
# Emergency SMS (backend — server/index.mjs)
# =============================================
# SMS_MODE=simulation | live   (simulation is the safe default, no real texts)
# SEMAPHORE_API_KEY=your-semaphore-api-key
# SEMAPHORE_SENDER_NAME=BAYANI
# SMS_PUBLIC_URL=http://localhost:4001
# SMS_PROVIDER=semaphore
#
# Backend CORS — origins allowed to call the API from a browser.
# Private/LAN addresses (localhost, 192.168.x.x, 10.x.x.x, …) are always
# allowed, so other PCs on the same network work with no config.
# CORS_ORIGINS=http://localhost:4000 http://localhost:4001

# =============================================
# Bayani Bridge — backend base URL (frontend — Vite)
# =============================================
# LEAVE COMMENTED OUT. The frontend then uses the same host as the page
# (hostname:8000), so the app works from other PCs on the LAN automatically.
# Only set this when the backend runs on a different machine.
#
# VITE_BRIDGE_URL=http://localhost:8000
